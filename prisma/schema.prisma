generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("buyer") // "buyer" | "admin"
  orders       Order[]
  chatThreads  ChatThread[]
  createdAt    DateTime @default(now())
}

model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  category      String
  brand         String?
  condition     String      @default("Refurbished") // "New" | "Refurbished" | "Used"
  price         Int
  originalPrice Int
  newPrice      Int?
  newInStock    Boolean     @default(false)
  grade         String // "A" | "B" | "C"
  battery       Int?
  warrantyDays  Int
  seller        String
  specs         String[]
  description    String?
  dimensions     String?
  refurbDetails  String?
  gradeNotes    String
  image         String
  imageUrl      String?
  imageUrls     String[]
  inStock       Boolean     @default(true)
  stockCount    Int?
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime    @default(now())
}

model Order {
  id                  String      @id @default(cuid())
  user                User?       @relation(fields: [userId], references: [id])
  userId              String?
  email               String
  status              String      @default("pending") // pending | paid | shipped | cancelled
  total               Int
  deliveryCountry     String?
  deliveryRegion      String?
  deliveryTown        String?
  deliveryLandmark    String?
  deliveryPhone       String?
  items               OrderItem[]
  reviewRequestSentAt DateTime?
  createdAt           DateTime    @default(now())
}

model OrderItem {
  id              String  @id @default(cuid())
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  product         Product @relation(fields: [productId], references: [id])
  productId       String
  qty             Int
  priceAtPurchase Int
}

model ListingSubmission {
  id          String   @id @default(cuid())
  name        String
  category    String
  grade       String
  askingPrice Int
  email       String
  status      String   @default("pending_review")
  createdAt   DateTime @default(now())
}

model ChatThread {
  id         String        @id @default(cuid())
  user       User?         @relation(fields: [userId], references: [id])
  userId     String?
  guestName  String?
  email      String?
  messages   ChatMessage[]
  lastAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())
}

model ChatMessage {
  id        String     @id @default(cuid())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  fromAdmin Boolean    @default(false)
  body      String
  readByAdmin Boolean  @default(false)
  createdAt DateTime   @default(now())
}

model Review {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  authorName    String
  authorLocation String? // e.g. "Nairobi, Kenya" — shown next to the name
  rating        Int      // 1-5
  body          String
  photoUrl      String?  // optional customer testimonial photo
  videoUrl      String?  // optional customer testimonial video
  approved      Boolean  @default(true)
  createdAt     DateTime @default(now())
}
